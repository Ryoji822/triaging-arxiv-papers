{
  "sources": {
    "publishers": {
      "acm": {
        "prefix": "10.1145",
        "label": "ACM",
        "enabled": true
      },
      "pvldb": {
        "prefix": "10.14778",
        "label": "PVLDB (VLDB Endowment)",
        "enabled": true
      },
      "ieee": {
        "prefix": "10.1109",
        "label": "IEEE",
        "enabled": true
      },
      "acl": {
        "prefix": "10.18653",
        "label": "ACL Anthology",
        "enabled": true
      },
      "springer": {
        "prefix": "10.1007",
        "label": "Springer",
        "enabled": false
      }
    }
  },
  "defaults": {
    "api_endpoint": "https://export.arxiv.org/api/query",
    "rss_endpoint": "https://rss.arxiv.org/rss/",
    "request_delay_seconds": 3.0,
    "user_agent": "arxiv-triage/1.0 (personal research digest; contact: set-your-email)",
    "lookback_days": 2,
    "max_results_per_bucket": 120,
    "keep_top_per_bucket": 25,
    "min_prescore": 1,
    "seen_retention_months": 4
  },
